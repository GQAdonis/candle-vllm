# Generated by candlevllm-config-wizard
# Multi-model candle-vllm configuration
#
# This configuration supports multiple models with a shared parking lot
# for request scheduling and resource management.
#
# Usage:
#   cargo run --release --features {{ feature_flag | default("metal") }} -- \
#     --config models.yaml --p {{ port | default(2000) }} --ui-server

default_model: {{ default_model | default(models[0].name) }}

{% if idle_unload_secs %}
# Unload idle models after this many seconds to free VRAM
idle_unload_secs: {{ idle_unload_secs | default(300) }}
{% endif %}

# Shared parking lot configuration for all models
parking_lot:
  pool:
    worker_threads: {{ parking_lot.worker_threads | default("num_cpus") }}
  limits:
    max_units: {{ parking_lot.max_units | default(4096) }}
    max_queue_depth: {{ parking_lot.max_queue_depth | default(100) }}
    timeout_secs: {{ parking_lot.timeout_secs | default(120) }}
  queue:
    backend: "{{ parking_lot.queue_backend | default("memory") }}"
    persistence: {{ parking_lot.persistence | default("false") }}
  mailbox:
    backend: "{{ parking_lot.mailbox_backend | default("memory") }}"
    retention_secs: {{ parking_lot.retention_secs | default(3600) }}

models:
{% for model in models %}
  # ── {{ model.name }} {{ "─" * (60 - model.name | length) }}
  - name: {{ model.name }}
    {% if model.hf_id %}
    hf_id: {{ model.hf_id }}
    {% endif %}
    {% if model.local_path %}
    local_path: {{ model.local_path }}
    {% endif %}
    {% if model.weight_file %}
    weight_file: {{ model.weight_file }}
    {% endif %}
    params:
      dtype: {{ model.dtype | default("bf16") }}
      mem: {{ model.mem | default(4096) }}
      {% if model.isq %}
      isq: {{ model.isq }}
      {% endif %}
      {% if model.device_ids %}
      device_ids: {{ model.device_ids }}
      {% endif %}
      {% if model.prefill_chunk_size %}
      prefill_chunk_size: {{ model.prefill_chunk_size | default(8192) }}
      {% endif %}
    {% if model.turboquant %}
    turboquant:
      bits: {{ model.turboquant.bits | default(3) }}
      policy: {{ model.turboquant.policy | default("always") }}
    {% endif %}
    {% if model.vision %}
    vision:
      mode: {{ model.vision.mode }}
      {% if model.vision.mode == "proxy" %}
      vision_proxy:
        hf_id: {{ model.vision.proxy_hf_id }}
        prompt_template: "{{ model.vision.proxy_prompt_template | default("Describe this image in detail: {image}") }}"
      {% endif %}
    {% endif %}
    {% if model.tool_calling %}
    tool_calling:
      enabled: {{ model.tool_calling.enabled | default("true") }}
      format: {{ model.tool_calling.format | default("auto") }}
    {% endif %}

{% endfor %}
