# Generated by candlevllm-config-wizard
# candle-vllm environment configuration
# Copy to .env and adjust values for your deployment

# ─── Server ───────────────────────────────────────────────────────────────────
PORT={{ port | default(2000) }}
HOST={{ host | default("0.0.0.0") }}

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: error, warn, info, debug, trace
RUST_LOG={{ rust_log | default("info") }}
{% if enable_log_file %}
LOG_FILE={{ log_file | default("candle-vllm.log") }}
{% endif %}

# ─── Model Configuration ─────────────────────────────────────────────────────
{% if models_config_path %}
MODELS_CONFIG={{ models_config_path | default("models.yaml") }}
{% endif %}
{% if hf_token %}
HF_TOKEN={{ hf_token }}
{% endif %}
{% if hf_cache_dir %}
HF_HOME={{ hf_cache_dir }}
{% endif %}

# ─── Hardware ─────────────────────────────────────────────────────────────────
{% if device_ids %}
# Comma-separated GPU device IDs (CUDA only)
DEVICE_IDS={{ device_ids }}
{% endif %}
{% if nccl_p2p_disable %}
# Disable NCCL peer-to-peer communication (set to 1 if experiencing GPU comm issues)
NCCL_P2P_DISABLE={{ nccl_p2p_disable }}
{% endif %}

# ─── Performance ──────────────────────────────────────────────────────────────
{% if dtype %}
DTYPE={{ dtype }}
{% endif %}
{% if mem %}
# KV cache memory budget in MB
MEM={{ mem }}
{% endif %}
{% if prefill_chunk_size %}
# Chunked prefill size (0 to disable, default 8192)
PREFILL_CHUNK_SIZE={{ prefill_chunk_size }}
{% endif %}

# ─── UI ───────────────────────────────────────────────────────────────────────
{% if enable_ui %}
UI_SERVER=true
{% endif %}

# ─── Redis (if using redis prompt cache or queue backend) ─────────────────────
{% if redis_url %}
REDIS_URL={{ redis_url }}
{% endif %}

# ─── Postgres (if using postgres queue backend) ──────────────────────────────
{% if postgres_url %}
DATABASE_URL={{ postgres_url }}
{% endif %}

# ─── MCP (Model Context Protocol) ────────────────────────────────────────────
{% if mcp_config %}
MCP_CONFIG={{ mcp_config | default("mcp.json") }}
{% endif %}
