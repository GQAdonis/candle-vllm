# Generated by candlevllm-config-wizard
# candle-vllm models configuration
# See: docs/CONFIGURATION.md for full reference

{% if idle_unload_secs %}
idle_unload_secs: {{ idle_unload_secs }}
{% endif %}

{% if default_model %}
default_model: {{ default_model }}
{% endif %}

{% if parking_lot %}
parking_lot:
  pool:
    worker_threads: {{ parking_lot.worker_threads }}
  limits:
    max_units: {{ parking_lot.max_units }}
    max_queue_depth: {{ parking_lot.max_queue_depth }}
    timeout_secs: {{ parking_lot.timeout_secs }}
  queue:
    backend: "{{ parking_lot.queue_backend }}"
    persistence: {{ parking_lot.persistence | default("false") }}
  mailbox:
    backend: "{{ parking_lot.mailbox_backend | default("memory") }}"
    retention_secs: {{ parking_lot.retention_secs | default(3600) }}
{% endif %}

{% if prompt_cache %}
prompt_cache:
  backend: "{{ prompt_cache.backend }}"
  min_prefix_length: {{ prompt_cache.min_prefix_length | default(16) }}
  max_cached_prefixes: {{ prompt_cache.max_cached_prefixes | default(256) }}
  {% if prompt_cache.backend == "sled" %}
  cache_path: "{{ prompt_cache.cache_path | default("./prompt_cache") }}"
  {% endif %}
  {% if prompt_cache.backend == "redis" %}
  redis_url: "{{ prompt_cache.redis_url | default("redis://localhost:6379") }}"
  {% endif %}
{% endif %}

models:
{% for model in models %}
  - name: {{ model.name }}
    {% if model.hf_id %}
    hf_id: {{ model.hf_id }}
    {% endif %}
    {% if model.local_path %}
    local_path: {{ model.local_path }}
    {% endif %}
    {% if model.weight_file %}
    weight_file: {{ model.weight_file }}
    {% endif %}
    params:
      dtype: {{ model.dtype | default("bf16") }}
      mem: {{ model.mem | default(4096) }}
      {% if model.isq %}
      isq: {{ model.isq }}
      {% endif %}
      {% if model.device_ids %}
      device_ids: {{ model.device_ids }}
      {% endif %}
      {% if model.prefill_chunk_size %}
      prefill_chunk_size: {{ model.prefill_chunk_size }}
      {% endif %}
    {% if model.turboquant %}
    turboquant:
      bits: {{ model.turboquant.bits | default(3) }}
      policy: {{ model.turboquant.policy | default("always") }}
    {% endif %}
    {% if model.vision %}
    vision:
      mode: {{ model.vision.mode }}
      {% if model.vision.mode == "proxy" %}
      vision_proxy:
        hf_id: {{ model.vision.proxy_hf_id }}
        prompt_template: "{{ model.vision.proxy_prompt_template | default("Describe this image in detail: {image}") }}"
      {% endif %}
    {% endif %}
    {% if model.tool_calling %}
    tool_calling:
      enabled: {{ model.tool_calling.enabled | default("true") }}
      format: {{ model.tool_calling.format | default("auto") }}
    {% endif %}
{% endfor %}
