# Generated by candlevllm-config-wizard
# Production-ready candle-vllm configuration
#
# This template includes all recommended production settings:
# - TurboQuant KV-cache compression
# - Prompt caching for common prefixes
# - Tuned parking lot for high throughput
# - Monitoring and observability settings
# - Resource limits and timeouts
#
# Usage:
#   cargo run --release --features {{ feature_flag | default("cuda,nccl,graph") }} -- \
#     --config models.yaml --p {{ port | default(2000) }} {% if enable_ui %}--ui-server{% endif %} --log

# ─── Global Settings ─────────────────────────────────────────────────────────

default_model: {{ default_model }}

# Unload models after idle period to reclaim VRAM in multi-model deployments
idle_unload_secs: {{ idle_unload_secs | default(600) }}

# ─── Parking Lot (Request Scheduling) ────────────────────────────────────────

parking_lot:
  pool:
    worker_threads: {{ parking_lot.worker_threads | default("num_cpus") }}
  limits:
    # Token budget for concurrent processing
    max_units: {{ parking_lot.max_units | default(8192) }}
    # Maximum queued requests before rejecting with 429
    max_queue_depth: {{ parking_lot.max_queue_depth | default(500) }}
    # Request timeout in seconds
    timeout_secs: {{ parking_lot.timeout_secs | default(300) }}
  queue:
    # Use persistent backend for production reliability
    backend: "{{ parking_lot.queue_backend | default("postgres") }}"
    persistence: {{ parking_lot.persistence | default("true") }}
  mailbox:
    backend: "{{ parking_lot.mailbox_backend | default("postgres") }}"
    # Retain completed results for 1 hour
    retention_secs: {{ parking_lot.retention_secs | default(3600) }}

# ─── Prompt Cache ─────────────────────────────────────────────────────────────

prompt_cache:
  # Use redis for shared cache across instances, sled for single-instance
  backend: "{{ prompt_cache.backend | default("redis") }}"
  # Minimum prefix length to cache (in tokens)
  min_prefix_length: {{ prompt_cache.min_prefix_length | default(16) }}
  # Maximum cached prefix entries
  max_cached_prefixes: {{ prompt_cache.max_cached_prefixes | default(512) }}
  {% if prompt_cache.backend | default("redis") == "redis" %}
  redis_url: "{{ prompt_cache.redis_url | default("redis://localhost:6379") }}"
  {% endif %}
  {% if prompt_cache.backend | default("redis") == "sled" %}
  cache_path: "{{ prompt_cache.cache_path | default("/var/lib/candle-vllm/prompt_cache") }}"
  {% endif %}

# ─── Monitoring ───────────────────────────────────────────────────────────────

{% if monitoring %}
monitoring:
  # Prometheus metrics endpoint
  metrics_enabled: {{ monitoring.metrics_enabled | default("true") }}
  metrics_port: {{ monitoring.metrics_port | default(9090) }}
  # Health check endpoint
  health_check_enabled: {{ monitoring.health_check_enabled | default("true") }}
  # Request logging
  log_requests: {{ monitoring.log_requests | default("true") }}
  log_request_body: {{ monitoring.log_request_body | default("false") }}
{% endif %}

# ─── Models ───────────────────────────────────────────────────────────────────

models:
{% for model in models %}
  # ── {{ model.name }} {{ "─" * (60 - model.name | length) }}
  - name: {{ model.name }}
    {% if model.hf_id %}
    hf_id: {{ model.hf_id }}
    {% endif %}
    {% if model.local_path %}
    local_path: {{ model.local_path }}
    {% endif %}
    {% if model.weight_file %}
    weight_file: {{ model.weight_file }}
    {% endif %}
    params:
      dtype: {{ model.dtype | default("bf16") }}
      # KV cache memory budget in MB -- size according to hardware
      mem: {{ model.mem | default(8192) }}
      {% if model.isq %}
      isq: {{ model.isq }}
      {% endif %}
      {% if model.device_ids %}
      # Multi-GPU device assignment
      device_ids: {{ model.device_ids }}
      {% endif %}
      # Chunked prefill for long-context efficiency
      prefill_chunk_size: {{ model.prefill_chunk_size | default(8192) }}

    # TurboQuant KV-cache compression -- recommended for production
    turboquant:
      bits: {{ model.turboquant.bits | default(3) }}
      {% if model.turboquant.policy is mapping %}
      policy:
        {% if model.turboquant.policy.threshold_tokens %}
        threshold_tokens: {{ model.turboquant.policy.threshold_tokens }}
        {% elif model.turboquant.policy.memory_pressure %}
        memory_pressure:
          free_block_pct: {{ model.turboquant.policy.memory_pressure.free_block_pct }}
        {% endif %}
      {% else %}
      policy: {{ model.turboquant.policy | default("always") }}
      {% endif %}

    {% if model.vision %}
    vision:
      mode: {{ model.vision.mode }}
      {% if model.vision.mode == "proxy" %}
      vision_proxy:
        hf_id: {{ model.vision.proxy_hf_id }}
        prompt_template: "{{ model.vision.proxy_prompt_template | default("Describe this image in detail: {image}") }}"
      {% endif %}
    {% endif %}

    {% if model.tool_calling %}
    tool_calling:
      enabled: {{ model.tool_calling.enabled | default("true") }}
      format: {{ model.tool_calling.format | default("auto") }}
    {% endif %}

    {% if model.rate_limit %}
    # Rate limiting per model
    rate_limit:
      requests_per_minute: {{ model.rate_limit.requests_per_minute }}
      tokens_per_minute: {{ model.rate_limit.tokens_per_minute }}
    {% endif %}

{% endfor %}
