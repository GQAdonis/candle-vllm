[Unit]
Description=Candle-vLLM Inference Server (Ministral 3 8B Reasoning + TurboQuant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gqadonis
Group=gqadonis

ExecStart=/usr/local/bin/candle-vllm \
    --m unsloth/Ministral-3-8B-Reasoning-2512-GGUF \
    --f Ministral-3-8B-Reasoning-2512-Q4_K_M.gguf \
    --mem 256 \
    --kvcache-compression-bits 3 \
    --kvcache-compression-policy always \
    --ui-server \
    --p 2000

Environment=HOME=/home/gqadonis
Environment=HUGGINGFACE_HUB_CACHE=/home/gqadonis/.cache/huggingface/hub
Environment=RUST_LOG=info

Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=candle-vllm

[Install]
WantedBy=multi-user.target
